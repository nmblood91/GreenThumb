APP_NAME=GreenThumb
API_PREFIX=/api/v1
DEBUG=false

# --- Motion ---
KLIPPER_HOST=/run/klipper/uds
GANTRY_RAIL_LENGTH_MM=1000
GANTRY_POSITION_MARGIN_MM=20

# --- Soil sensors ---
# I2C addresses for STEMMA soil sensors: 54=0x36, 55=0x37, 56=0x38, 57=0x39
MOISTURE_SENSOR_ADDRESSES=54,55,56,57
# Raw capacitance readings that map to 0% and 100%. Measure dry in soil the
# plant would want watering in, wet in a saturated pot.
MOISTURE_RAW_DRY=350
MOISTURE_RAW_WET=1016

# --- Control loop ---
SENSOR_POLL_SECONDS=60
# Watering uses the mean of this many polls, so 10 at 60s is a 10 minute trend.
MOISTURE_WINDOW_SIZE=10
# Leave off until the pump has been tested by hand and the flow rate measured.
AUTO_WATERING_ENABLED=false
WATERING_COOLDOWN_MINUTES=30

# --- Water supply ---
# Blocks watering when the supply tube reads dry. Needs the liquid sensor wired
# to Y-STOP and its polarity confirmed first: while this is on, an unreadable
# sensor also blocks, since a sensor declared present but silent is a fault.
WATER_SENSOR_ENABLED=false

# --- Pump ---
# Matches the [output_pin] section name in printer.cfg (pump is on HE0/PC8)
PUMP_PIN_NAME=pump
# 100 mL/min rated = 1.67 mL/s, before head pressure and tubing losses.
# Measure against a real dose: this converts millilitres into a pump run time.
PUMP_FLOW_ML_PER_SECOND=1.67

# --- Lighting ---
# Strip chip, selectable in the settings page. Sets the signal timing and the
# usual channel order. WS2812B (5V), WS2815 and GS8208 (12V) give one pixel per
# LED; WS2811 (12V) drives three LEDs per pixel, so set LED_COUNT to LEDs/3.
LED_CHIP=WS2812B
# Addressable pixels, not LEDs. Data goes out on SPI MOSI (GPIO10, pin 19).
LED_COUNT=60
# Overrides the chip's usual order, for strips wired differently.
LED_COLOR_ORDER=GRB
LED_SPI_BUS=0
LED_SPI_DEVICE=0
