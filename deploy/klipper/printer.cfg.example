[mcu]
serial: /dev/serial/by-id/usb-Klipper_xxx
restart_method: command

[printer]
kinematics: cartesian
max_velocity: 400
max_accel: 4000
max_z_velocity: 15
max_z_accel: 100

# X coordinates: the endstop switch trips at X980, inside the dead zone at the
# right end, next to the motor. Usable travel is X0 to X960; the 20 mm at each
# end of the 1 m rail is unreachable by the carriage. Measure position_endstop
# against your own switch mounting -- see deploy/README.md.
#
# Homing at the motor end keeps the belt span between pulley and carriage at its
# shortest when the switch trips, so the reference is the most repeatable point
# on the rail.
[stepper_x]
step_pin: PB13
dir_pin: PB12
enable_pin: !PB14
microsteps: 16
rotation_distance: 40
endstop_pin: ^!PC0
position_min: 0
position_max: 980
position_endstop: 980
# Stated rather than inferred: Klipper would work this out from position_endstop
# sitting at the top of the range, but then a later edit to position_max could
# silently reverse the homing direction.
homing_positive_dir: True
homing_speed: 40
second_homing_speed: 10
homing_retract_dist: 5

[tmc2209 stepper_x]
uart_pin: PC11
tx_pin: PC10
uart_address: 0
run_current: 0.7
stealthchop_threshold: 999999

# Park clear of the switch after homing so the first move in either direction
# is legal; sitting on position_max makes any rightward jog fail.
[homing_override]
axes: x
gcode:
    G28.1 X
    G90
    G1 X960 F3000

[force_move]
enable_force_move: True

# Non-contact liquid sensor clamped on the supply tube between reservoir and
# pump inlet. Declared as a filament sensor purely because that exposes the pin
# state through objects/query; runout handling is off, the watering logic owns
# the decision. Flip to ^!PC1 if a full tube reads as empty.
[filament_switch_sensor water_supply]
switch_pin: ^PC1
pause_on_runout: False

[stepper_y]
step_pin: PB10
dir_pin: PB2
enable_pin: !PB11
microsteps: 16
rotation_distance: 40
endstop_pin: ^!PC1
position_min: 0
position_max: 200
position_endstop: 0

[tmc2209 stepper_y]
uart_pin: PC11
tx_pin: PC10
uart_address: 1
run_current: 0.7
stealthchop_threshold: 999999

[stepper_z]
step_pin: PB0
dir_pin: PC5
enable_pin: !PB1
microsteps: 16
rotation_distance: 8
endstop_pin: ^!PC2
position_min: 0
position_max: 200
position_endstop: 0

[tmc2209 stepper_z]
uart_pin: PC11
tx_pin: PC10
uart_address: 2
run_current: 0.7
stealthchop_threshold: 999999

[virtual_sdcard]
path: ~/printer_data/gcodes

[pause_resume]

[display_status]
[respond]

# Pump on the HE0 MOSFET, switching whatever the board is fed (12V here).
# Deliberately not a [heater_generic]: that requires a temperature sensor, and
# verify_heater would fault mid-dose when commanded heat produces no rise.
# shutdown_value stops the pump if Klipper errors out partway through watering.
[output_pin pump]
pin: PC8
value: 0
shutdown_value: 0

[gcode_macro HOME_GANTRY]
description: Home the gantry on the X axis
gcode:
    G28 X

[gcode_macro MOVE_LEFT_10]
description: Move gantry left by 10 mm
gcode:
    G91
    G1 X-10 F6000
    G90

[gcode_macro MOVE_RIGHT_10]
description: Move gantry right by 10 mm
gcode:
    G91
    G1 X10 F6000
    G90
